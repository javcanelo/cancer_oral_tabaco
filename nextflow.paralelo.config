executor {
    queueSize = 2
    cpus = 8
    memory = '6 GB'
}

process {
    withName: salmon_quant {
        cpus = 6
        memory = '4 GB'
        maxForks = 1
    }

    withName: fastp {
        cpus = 2
        memory = '2 GB'

        // Publicar los reportes; los FASTQ permanecen en work.
        publishDir = [
            path: { "${params.output_dir}/fastp" },
            mode: 'copy',
            pattern: '*_fastp.*'
        ]
    }

    withName: 'fastqc|fastqc_post_trimming' {
        cpus = 2
        memory = '1 GB'
    }

    withName: multiqc {
        cpus = 1
        memory = '2 GB'
    }
}
